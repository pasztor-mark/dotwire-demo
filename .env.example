# Copy to .env.local for `pnpm dev` against a local dotwire stack (dotwire repo: `docker compose up`).
# In production every value marked "per boot" is generated by deploy/boot/init.sh and never set by hand.

# dotwire gateway as seen from the Next.js server
DOTWIRE_INTERNAL_URL=http://127.0.0.1:8080

# RS256 private key whose public half dotwire trusts under kid "demo" (per boot).
# Locally: the dev-jwt.key from the dotwire README, with dotwire's Auth__Keys__demo set to its public half.
DOTWIRE_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# HMAC secret shared with dotwire's Dotwire__Webhooks__Secret (per boot; any value locally)
WEBHOOK_SECRET=local-webhook-secret

# Signs session cookies and form timestamps (per boot; any value locally)
SIGNING_SECRET=local-signing-secret

# "true" turns the live demo on; anything else serves only the project landing page
DEMO_ENABLED=true

# Cloudflare Turnstile — the only long-lived secret (Fly secret in production); demo only
TURNSTILE_SECRET_KEY=
# Public site key; inlined at build time
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Hostname Turnstile must report (fly.toml [env] in production)
PUBLIC_HOST=localhost
