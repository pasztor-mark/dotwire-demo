#!/command/with-contenv sh
# Inherits DOTWIRE_PRIVATE_KEY_PEM, WEBHOOK_SECRET, SIGNING_SECRET (init.sh), TURNSTILE_SECRET_KEY
# (Fly secret) and PUBLIC_HOST (fly.toml [env]) through with-contenv.
cd /app/web
export HOSTNAME=127.0.0.1 PORT=3000 NODE_ENV=production NEXT_TELEMETRY_DISABLED=1
exec /command/s6-setuidgid app /usr/local/bin/node server.js
